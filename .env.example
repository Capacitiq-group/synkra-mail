# Synkra Email — environment configuration (copy to .env / systemd Environment=)
# Every knob has a dev-safe default; values below are the dev bootstrap.

# Database (embedded dev instance on 5433; VPS will run its own Postgres)
SYNKRA_MAIL_DATABASE_URL=postgres://synkra@127.0.0.1:5433/synkra_mail?sslmode=disable
SYNKRA_MAIL_ENV=dev

# Domains
SYNKRA_MAIL_PLATFORM_DOMAIN=synkra.email
SYNKRA_MAIL_TRACKING_HOST=trk.synkra.email
# THIS server's mail identity: EHLO name, bounce Reporting-MTA, Message-ID
# domain, and the MX target shown in the DNS doctor. Must resolve forward and
# reverse (FCrDNS) — set it to the sending VPS's mail name.
SYNKRA_MAIL_HOSTNAME=mx1.synkra.co.za

# Secrets — MUST be overridden in prod (config.Load refuses defaults in prod)
SYNKRA_MAIL_COOKIE_SECRET=dev-cookie-secret
SYNKRA_MAIL_TRACKING_SECRET=dev-tracking-secret

# Blob storage: fs (dev) | s3 (Stage-A production, Contabo Z1)
SYNKRA_MAIL_BLOB_MODE=fs
SYNKRA_MAIL_BLOB_DIR=./devdata/blobs

# S3 mode (any S3-compatible endpoint: Contabo Object Storage, MinIO, AWS).
# Endpoint/region/bucket are deployment config — set them after the owner's
# data-residency sign-off. Keys are secrets: never commit them.
#SYNKRA_MAIL_S3_ENDPOINT=https://eu2.contabostorage.com
#SYNKRA_MAIL_S3_REGION=eu2
#SYNKRA_MAIL_S3_BUCKET=mail-prod
#SYNKRA_MAIL_S3_ACCESS_KEY=change-me
#SYNKRA_MAIL_S3_SECRET_KEY=change-me
#SYNKRA_MAIL_S3_PATH_STYLE=true

# Listeners (dev; prod maps to 25 / 465-587 / 993 with TLS)
SYNKRA_MAIL_SMTP_IN_ADDR=127.0.0.1:2025
SYNKRA_MAIL_SUBMISSION_ADDR=127.0.0.1:2587
SYNKRA_MAIL_IMAP_ADDR=127.0.0.1:1143
SYNKRA_MAIL_HTTP_ADDR=127.0.0.1:8080
SYNKRA_MAIL_TRACKER_ADDR=127.0.0.1:8081
SYNKRA_MAIL_TRACKER_URL=http://127.0.0.1:8081

# TLS (prod: ACME cert paths; enables implicit-TLS listeners)
#SYNKRA_MAIL_TLS_CERT=/etc/synkra/mail.crt
#SYNKRA_MAIL_TLS_KEY=/etc/synkra/mail.key
#SYNKRA_MAIL_SUBMISSION_TLS_ADDR=0.0.0.0:465

# Outbound policy (owner rules, Section 7.3 of the design doc)
SYNKRA_MAIL_NEW_ORG_DAILY=100
SYNKRA_MAIL_NEW_MAILBOX_HOURLY=20
SYNKRA_MAIL_MAX_RECIPIENTS=50
SYNKRA_MAIL_VERIFIED_MAILBOX_DAILY=500
SYNKRA_MAIL_VERIFIED_ORG_DAILY=2000
SYNKRA_MAIL_BREAKER_PCT=5
SYNKRA_MAIL_BREAKER_WINDOW=24h
SYNKRA_MAIL_BREAKER_MIN=20
SYNKRA_MAIL_MAX_MESSAGE_MB=25
#SYNKRA_MAIL_WARMUP_DAILY_CAP=100   # set during IP warmup (Section 8.3)

# Login throttling (fail-count in the window locks the account)
SYNKRA_MAIL_LOGIN_MAX_FAILS=10
SYNKRA_MAIL_LOGIN_WINDOW=10m
SYNKRA_MAIL_LOGIN_LOCKOUT=15m

# App passwords (owner decision: 10 active max, 180-day expiry)
SYNKRA_MAIL_APP_PW_MAX=10
SYNKRA_MAIL_APP_PW_AGE_DAYS=180

# Trial (owner decision: 14 days, no outbound before payment/approval)
SYNKRA_MAIL_TRIAL_DAYS=14

# Workers
SYNKRA_MAIL_WORKERS=4
SYNKRA_MAIL_WORKER_POLL=2s

# Bootstrap (used by `maild -seed` only)
#SYNKRA_ADMIN_EMAIL=admin@synkra.co.za
#SYNKRA_ADMIN_PASSWORD=change-me
